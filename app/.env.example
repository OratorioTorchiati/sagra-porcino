# Copia questo file in .env.local (non va su git) e metti i valori del progetto Supabase
# (Supabase → Project Settings → API Keys). La chiave publishable/anon è pubblica per definizione.
# MAI mettere qui la chiave service_role / secret.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Facoltativo, solo per `npm run test:db`: un account staff DI PROVA (non quello vero della sagra)
# per provare anche le funzioni del pannello staff. Il file .env.local non va su git.
# TEST_STAFF_NICKNAME=zzstaff
# TEST_STAFF_PASSWORD=
